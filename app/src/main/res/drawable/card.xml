<?xml version="1.0" encoding="utf-8"?>
<!-- 묶어 두는 칸 - 리벳 박은 회색 금속판(웹 .ptt-page 판과 한 벌). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3a3f45" android:centerColor="#2b2f34" android:endColor="#212428" />
            <stroke android:width="1dp" android:color="#50565d" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:width="9dp" android:height="9dp" android:gravity="top|left" android:top="9dp" android:left="9dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="5dp" android:centerX="0.4" android:centerY="0.35"
                android:startColor="#b4bac1" android:endColor="#3a3f45" />
            <stroke android:width="1dp" android:color="#141618" />
        </shape>
    </item>
    <item android:width="9dp" android:height="9dp" android:gravity="top|right" android:top="9dp" android:right="9dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="5dp" android:centerX="0.4" android:centerY="0.35"
                android:startColor="#b4bac1" android:endColor="#3a3f45" />
            <stroke android:width="1dp" android:color="#141618" />
        </shape>
    </item>
    <item android:width="9dp" android:height="9dp" android:gravity="bottom|left" android:bottom="9dp" android:left="9dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="5dp" android:centerX="0.4" android:centerY="0.35"
                android:startColor="#b4bac1" android:endColor="#3a3f45" />
            <stroke android:width="1dp" android:color="#141618" />
        </shape>
    </item>
    <item android:width="9dp" android:height="9dp" android:gravity="bottom|right" android:bottom="9dp" android:right="9dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="5dp" android:centerX="0.4" android:centerY="0.35"
                android:startColor="#b4bac1" android:endColor="#3a3f45" />
            <stroke android:width="1dp" android:color="#141618" />
        </shape>
    </item>
</layer-list>
