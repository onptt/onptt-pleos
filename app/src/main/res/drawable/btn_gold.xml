<?xml version="1.0" encoding="utf-8"?>
<!-- 로그인 전 주 단추 - 노란 빛이 유리 뒤에서. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4a3a0e" android:endColor="#2d2207" />
            <stroke android:width="2dp" android:color="@color/door_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1a1d21" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3d300b" android:endColor="#241b05" />
            <stroke android:width="2dp" android:color="@color/door_gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
