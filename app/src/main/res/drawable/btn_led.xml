<?xml version="1.0" encoding="utf-8"?>
<!-- 주 단추 - 녹색 LED 가 유리 뒤에서 빛나는 모양. 누르면 조금 밝아진다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24472f" android:endColor="#12301d" />
            <stroke android:width="2dp" android:color="@color/gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1a1d21" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#1d3a29" android:endColor="#0f2418" />
            <stroke android:width="2dp" android:color="@color/gold" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
