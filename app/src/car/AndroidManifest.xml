<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차에만 깔린다. 이게 있어야 Pleos App Market 이 차용으로 본다. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 폰에서 쓰던 것 중 차에서 뜻이 없는 것은 여기서 지운다.
         절전 예외를 묻는 창은 차에 없고(띄우면 빈 화면이 뜬다),
         WAKE_LOCK 은 배터리 때문에 접었던 것이라 들고 올 까닭이 없다. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove"
        xmlns:tools="http://schemas.android.com/tools" />

    <!-- 플레오스 SDK(Pleos.kt). 기어는 CAR_DRIVE, 내비 자리·목적지는 NAVI_ROUTE,
         길 안내 걸기는 NAVI_ROUTE_SEARCH. 안 주셔도 무전은 그대로 된다. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 남은 힘(배터리·연료·주행 가능 거리)과 사고 감지(에어백). -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 음성 - 읽어 주기(TTS)·받아쓰기(STT). -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <application>
        <!-- 방향을 안 적는다. 차 화면은 가로로 고정되어 있고,
             세로를 박아 두면 그 넓은 화면에 세로 띠가 뜬다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- **주행 중에도 쓰는 화면이다(운전 방해 최적화).** 이것이 없으면 기어가 P 를 벗어나는 순간
                 차가 「주행 중에는 사용할 수 없습니다」 로 화면을 통째로 가린다 - 달리면서 쓰는 무전기가
                 정작 달릴 때 막혔다(2026-11-03, 버추얼 콘솔로 기어 D). 주행 중 글자 입력·설정은 앱이
                 스스로 막는다(Pleos.driving). -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />
    </application>

</manifest>
